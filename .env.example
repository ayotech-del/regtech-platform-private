# Superuser connection: used only for migrations and tenant provisioning (app.cli).
# The running API never uses this URL.
DATABASE_URL_MIGRATIONS=postgresql+psycopg://postgres:postgres@localhost:5434/regtech

# app_user connection: NOSUPERUSER NOBYPASSRLS, the only role the FastAPI app connects as.
# Role + password are created by migration 0001; password here must match.
DATABASE_URL_APP=postgresql+psycopg://app_user:app_user_dev_password@localhost:5434/regtech
APP_DB_PASSWORD=app_user_dev_password

# Identity & Verification module
IDENTITY_PROVIDER=mock
IDENTITY_HASH_PEPPER=dev-only-change-me-in-prod

# Sanctions & Watchlist Screening module
WATCHLIST_PROVIDER=mock
SANCTIONS_MATCH_THRESHOLD=70.0
